<idea-plugin>
    <!--
      Loaded only where the IDE has VCS support (com.intellij.modules.vcs), so the
      commit-dialog action and the VCS classes it uses never load in an IDE
      without it.
    -->
    <extensions defaultExtensionNs="com.intellij">
        <notificationGroup
            id="claude-code-gui.commit-message"
            displayType="BALLOON"
            displayName="Claude Code Commit Message"/>
    </extensions>

    <actions>
        <!-- Write the commit message for the included changes: the backend runs
             git diff and one `claude -p`, this puts the answer in the box. -->
        <action
            id="ClaudeCode.GenerateCommitMessage"
            class="com.github.yhk1038.claudecodegui.vcs.GenerateCommitMessageAction"
            text="Generate Commit Message with Claude"
            description="Write a commit message for the changes included in this commit with Claude Code"
            icon="/icons/claudeCode.svg">
            <add-to-group group-id="Vcs.MessageActionGroup" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
